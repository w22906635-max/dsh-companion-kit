+ *   否则模型又会把它当成对方说的话。
+ */
+function 拼目的文案(配置, 条目) {
+  const 底 = String(配置.触发文案 || '').trim()
+  const 类 = 条目.split('：')[0]
+  return [
+    底,
+    `（这会儿心里冒出来的，是「${类}」这一挂的事：${条目.slice(类.length + 1)}）`,
+    '（用你自己的语气说，一两句就够；别照抄上面这句，也别解释"这是我的设定"。）',
+  ].join(String.fromCharCode(10))
+}
