+function 今天() {
+  const d = new Date()
+  const 补 = (n) => String(n).padStart(2, '0')
+  return `${d.getFullYear()}-${补(d.getMonth() + 1)}-${补(d.getDate())}`
+}
+
+function 读目的状态() {
+  try {
+    const o = JSON.parse(readFileSync(目的状态文件, 'utf8'))
+    return {
+      日期: typeof o.日期 === 'string' ? o.日期 : '',
+      今日次数: Number(o.今日次数) || 0,
+      最近目的: Array.isArray(o.最近目的) ? o.最近目的.slice(-20) : [],
+    }
+  } catch (error) {
+    return { 日期: '', 今日次数: 0, 最近目的: [] }
+  }
+}
+
+function 写目的状态(状态) {
+  try {
+    mkdirSync(目录, { recursive: true })
+    writeFileSync(目的状态文件, JSON.stringify(状态, null, 2), 'utf8')
+    return true
+  } catch (error) {
+    return false
+  }
+}
+
+/** 今天已经开口几次（跨天自动归零）。 */
+function 今日开口次数() {
+  const 状态 = 读目的状态()
+  return 状态.日期 === 今天() ? 状态.今日次数 : 0
+}
+
+/** 记一次"真的送出去了"。 */
+function 记一次开口(条目) {
+  const 状态 = 读目的状态()
+  const 新 = {
+    日期: 今天(),
+    今日次数: (状态.日期 === 今天() ? 状态.今日次数 : 0) + 1,
+    最近目的: [...状态.最近目的, 条目].slice(-20),
+  }
+  写目的状态(新)
+  return 新
+}
+
+/** 挑一个念头：避开最近 6 条用过的。 */
+function 挑目的() {
+  const 状态 = 读目的状态()
+  const 禁用 = new Set(状态.最近目的.slice(-6))
+  const 候选 = []
+  for (const 组 of 目的库) {
+    for (const 文本 of 组.文本) {
+      const 条目 = `${组.类}：${文本}`
+      if (!禁用.has(条目)) 候选.push(条目)
+    }
+  }
+  const 池 = 候选.length ? 候选 : 目的库.flatMap((组) => 组.文本.map((t) => `${组.类}：${t}`))
+  return 池[Math.floor(Math.random() * 池.length)]
